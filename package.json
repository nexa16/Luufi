{
  "name": "luufi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "predev": "npm run db:migrate:local",
    "dev": "vinext dev",
    "build": "vinext build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app components lib tests scripts .github vitest.*.ts playwright.config.ts",
    "format": "oxfmt",
    "db:migrate:local": "node .github/scripts/local-d1-migrations.cjs",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:ui && npm run test:worker",
    "test:coverage": "npm run test:unit -- --coverage && npm run test:ui -- --coverage && npm run test:worker -- --coverage",
    "test:ci": "npm run test:docs && npm run test:coverage && npm run test:e2e",
    "test:docs": "node scripts/verify-docs.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/vitest-plugin": "1.1.7",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "4.1.10",
    "wrangler": "4.92.0"
  }
}
